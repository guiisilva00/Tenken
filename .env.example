# Portas publicadas no host somente em desenvolvimento local.
# O Coolify usa docker-compose.yml sem docker-compose.override.yml, entao
# o proxy acessa as portas internas dos containers sem publicar no host.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
DATABASE_HOST_PORT=3306

# Portas internas dos containers.
# Normalmente so altere se a plataforma exigir.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# URLs usadas entre navegador, frontend e backend.
# Em producao, substitua localhost pelos dominios configurados no Coolify.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Banco de dados.
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=tenken_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password

DB_HOST=database
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=tenken_db

# E-mail para redefinição de senha (587 com STARTTLS ou 465 com TLS direto).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=senha_de_aplicativo
SMTP_FROM="Tenken <nao-responda@tenken.app>"
