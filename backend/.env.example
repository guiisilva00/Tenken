
# ==========================================
# CONFIGURAÇÕES DO PROJETO
# ==========================================

# SERVIDOR
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# BANCO DE DADOS (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=tenken_db

# AUTENTICAÇÃO (JWT)
JWT_SECRET=gere_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# ENVIO DE E-MAIL (SMTP)
# Gmail: smtp.gmail.com
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=seu_email@exemplo.com
SMTP_PASS=sua_senha_de_aplicativo

# Nome e endereço exibidos como remetente
SMTP_FROM="Tenken <nao-responda@exemplo.com>"